# Convex deployment URL (generated by `npx convex dev` or from Convex dashboard)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Convex deployment name (for server-side operations, optional)
CONVEX_DEPLOYMENT=your-deployment-name

# Convex deploy key (for CI/CD deployments, keep secret!)
CONVEX_DEPLOY_KEY=your-deploy-key

# Cron secret for /api/fantrax/capture endpoint
CRON_SECRET=your-random-secret-here
