# Base URL (optional, for production)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase (optional — Form falls back to live Fantrax projections if not set)
# Required to freeze weekly projections before Fantrax overwrites them with scored FPts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Vercel Cron Authorization: Bearer <CRON_SECRET>
# Required in production. Vercel Cron sends this header automatically when the env var is set.
CRON_SECRET=generate-a-long-random-string
