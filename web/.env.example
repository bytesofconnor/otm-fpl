# Example environment variables for Over the Moon

# Base URL (optional, for production)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase (optional — app falls back to live Fantrax projections if not configured)
# Required for frozen weekly projection snapshots that persist after fixtures complete
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Note: SUPABASE_SERVICE_ROLE_KEY should NEVER be exposed to the client.
# It's used server-side only (API routes) to write projection snapshots.
